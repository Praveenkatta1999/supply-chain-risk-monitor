# Copy to .env and fill in. Auth is Application Default Credentials only:
#   gcloud auth application-default login
# Never put service account keys in this repo.

# Google Cloud / Gemini Enterprise Agent Platform (formerly Vertex AI)
GOOGLE_CLOUD_PROJECT=dopl-507205
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true

# App settings
SCRM_BQ_DATASET=scrm
SCRM_BQ_LOCATION=US
# Refuse any query whose dry run estimates more than this (default 10 GiB)
SCRM_MAX_BYTES_BILLED=10737418240
SCRM_GEMINI_MODEL=gemini-3.5-flash
# Investigator sampling temperature (default 0.2; Google recommends 1.0 for Gemini 3.x)
SCRM_INVESTIGATOR_TEMPERATURE=0.2
SCRM_LOG_LEVEL=INFO
